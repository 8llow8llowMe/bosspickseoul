# =============================================================================
# BossPickSeoul backend shared environment template
#
# 이 파일은 "어떤 키들이 필요한가"를 보여주는 전체 계약 예시입니다.
# 실제 운영 배포에서는 Jenkins 가 Vault 에서 서비스별 env_file 값을 읽어
# `.env.runtime` 파일로 생성한 뒤 `docker compose --env-file` 로 주입합니다.
#
# 중요:
# 1) compose 파일들이 `${...}` 치환을 많이 사용하므로 Vault 의 env_file 값은
#    비밀값 일부만이 아니라 "해당 서비스가 실제로 필요로 하는 전체 .env 내용"이어야 합니다.
# 2) dev / prod / 서비스별로 필요한 값을 분리해 Vault 에 저장하세요.
# 3) Linux Docker 에서는 `host.docker.internal` 이 항상 보장되지 않으므로
#    운영 env 에서는 실제 접근 가능한 호스트명/IP 로 교체하는 것을 권장합니다.
# =============================================================================

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------
TIME_ZONE=Asia/Seoul
SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------------------
# Service application names (Eureka 등록 ID)
# ---------------------------------------------------------------------------
SERVICE_DISCOVERY_APP_NAME=service-discovery
API_GATEWAY_APP_NAME=api-gateway
AUTH_SERVICE_APP_NAME=auth-service
COMMERCIAL_SERVICE_APP_NAME=commercial-service
DISTRICT_SERVICE_APP_NAME=district-service
COMMUNITY_SERVICE_APP_NAME=community-service
AI_SERVICE_APP_NAME=ai-service
BATCH_SERVICE_APP_NAME=batch-service

# ---------------------------------------------------------------------------
# Container 내부 포트
# ---------------------------------------------------------------------------
SERVICE_DISCOVERY_PORT=8761
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8081
DISTRICT_SERVICE_PORT=8082
COMMERCIAL_SERVICE_PORT=8083
AI_SERVICE_PORT=8085
COMMUNITY_SERVICE_PORT=8086
BATCH_SERVICE_PORT=8080

# Eureka 클라이언트가 바라볼 service-discovery 컨테이너
# prod 예시이며 dev 환경에서는 bosspickseoul-service-discovery-dev 로 분리하세요.
SERVICE_DISCOVERY_HOSTNAME=bosspickseoul-service-discovery-prod

# ---------------------------------------------------------------------------
# Host 외부 노출 포트 (BossPickSeoul = dev:6XXX / prod:9XXX)
# ---------------------------------------------------------------------------
SERVICE_DISCOVERY_PORT_DEV=6761
SERVICE_DISCOVERY_PORT_PROD=9761

API_GATEWAY_PORT_DEV=6000
API_GATEWAY_PORT_PROD=9000

AUTH_SERVICE_PORT_DEV=6081
AUTH_SERVICE_PORT_PROD=9081

DISTRICT_SERVICE_PORT_DEV=6082
DISTRICT_SERVICE_PORT_PROD=9082

COMMERCIAL_SERVICE_PORT_DEV=6083
COMMERCIAL_SERVICE_PORT_PROD=9083

AI_SERVICE_PORT_DEV=6085
AI_SERVICE_PORT_PROD=9085

COMMUNITY_SERVICE_PORT_DEV=6086
COMMUNITY_SERVICE_PORT_PROD=9086

BATCH_SERVICE_PORT_DEV=6080
BATCH_SERVICE_PORT_PROD=9080

# ---------------------------------------------------------------------------
# Database
# 운영 env 에서는 host.docker.internal 대신 실제 DB 노드 호스트명/IP 사용 권장
# ---------------------------------------------------------------------------
DB_USERNAME=
DB_PASSWORD=

AUTH_DB_URL=jdbc:mysql://host.docker.internal:3306/bosspickseoul_auth
COMMERCIAL_DB_URL=jdbc:mysql://host.docker.internal:3306/bosspickseoul_commercial
DISTRICT_DB_URL=jdbc:mysql://host.docker.internal:3306/bosspickseoul_district
COMMUNITY_DB_URL=jdbc:mysql://host.docker.internal:3306/bosspickseoul_community
# batch-service 는 district-service 가 조회하는 area_boundary 데이터를 적재합니다.
# 따라서 BATCH_DB_URL 은 별도 batch 스키마가 아니라 district 스키마를 가리켜야 합니다.
BATCH_DB_URL=jdbc:mysql://host.docker.internal:3306/bosspickseoul_district

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# standalone, sentinel
REDIS_MODE=standalone
REDIS_HOST=redis-node2
REDIS_PORT=6379
REDIS_PASSWORD=
# bosspickseoul:dev, bosspickseoul:prod
REDIS_KEY_PREFIX=bosspickseoul:dev

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=
JWT_ACCESS_EXPIRATION=PT420M
JWT_REFRESH_EXPIRATION=PT10080M

# ---------------------------------------------------------------------------
# Snowflake ID
# ---------------------------------------------------------------------------
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1

# ---------------------------------------------------------------------------
# AI / LLM
# 운영 env 에서는 host.docker.internal 대신 실제 ai-host 주소 사용 권장
# ---------------------------------------------------------------------------
AI_LLM_PROVIDER=OLLAMA
AI_LLM_BASE_URL=http://host.docker.internal:11434
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-oss:20b
AI_LLM_TIMEOUT_MS=30000
AI_LLM_MAX_TOKENS=1200
AI_LLM_TEMPERATURE=0.2

AI_REPORT_CACHE_TTL_SECONDS=86400
AI_REPORT_JOB_TTL_SECONDS=86400
AI_REPORT_JOB_USAGE_TTL_SECONDS=2592000
AI_REPORT_JOB_PENDING_TIMEOUT_SECONDS=30
AI_REPORT_JOB_RUNNING_TIMEOUT_SECONDS=300
