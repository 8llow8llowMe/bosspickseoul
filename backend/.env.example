# =============================================================================
# BossPickSeoul backend shared environment template
#
# 이 파일은 Vault에 저장할 backend env 계약 예시입니다.
# 실제 값은 Git에 커밋하지 않고 Vault 경로별 key/value로 저장합니다.
#
# 권장 Vault path:
# - kv/bosspickseoul/backend/dev/env
# - kv/bosspickseoul/backend/prod/env
#
# Jenkins 배포 흐름:
# Vault -> .env.runtime 생성 -> docker compose --env-file .env.runtime 주입
#
# 원칙:
# - compose 파일에서 ${...} 치환하는 전체 키를 포함합니다.
# - dev/prod는 같은 key 목록을 유지하고 value만 다르게 둡니다.
# - Linux Docker에서는 host.docker.internal 대신 실제 접근 가능한 IP/DNS를 권장합니다.
# =============================================================================

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------
TIME_ZONE=Asia/Seoul
SPRING_PROFILES_ACTIVE=dev
JASYPT_ENCRYPTOR_KEY=

# ---------------------------------------------------------------------------
# Service application names (Eureka 등록 ID)
#
# Gateway route(lb://${*_APP_NAME})와 Feign client
# (feign-client.target-services.* -> ${*_APP_NAME}) 모두 이 값으로 대상 서비스를
# 해석하므로, 접미사를 포함한 이 값이 Eureka 등록명의 단일 기준입니다.
# 여기에 새 값을 추가하면 호출하는 쪽 서비스의 compose environment에도 주입해야 합니다.
# ---------------------------------------------------------------------------
# Eureka 등록/라우팅에 쓰는 애플리케이션 이름입니다. 환경별 접미사로 dev/prod를 구분합니다.
# 아래는 dev 예시이며, prod secret(kv/bosspickseoul/backend/prod/env)에서는 -prod를 사용합니다.
SERVICE_DISCOVERY_APP_NAME=service-discovery-dev
API_GATEWAY_APP_NAME=api-gateway-dev
AUTH_SERVICE_APP_NAME=auth-service-dev
COMMERCIAL_SERVICE_APP_NAME=commercial-service-dev
DISTRICT_SERVICE_APP_NAME=district-service-dev
COMMUNITY_SERVICE_APP_NAME=community-service-dev
AI_SERVICE_APP_NAME=ai-service-dev
BATCH_SERVICE_APP_NAME=batch-service-dev

# ---------------------------------------------------------------------------
# Container internal ports
# ---------------------------------------------------------------------------
SERVICE_DISCOVERY_PORT=8761
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8081
DISTRICT_SERVICE_PORT=8082
COMMERCIAL_SERVICE_PORT=8083
AI_SERVICE_PORT=8085
COMMUNITY_SERVICE_PORT=8086
BATCH_SERVICE_PORT=8080

# Eureka client 접속 대상(=붙을 Eureka 서버 컨테이너)입니다.
# 배포는 환경별로 자기 Vault secret(kv/bosspickseoul/backend/<env>/env)만 읽고
# 자기 환경 컨테이너 하나만 띄우므로, 이 값을 환경별로 다르게 넣으면 레지스트리가 격리됩니다.
#   dev  배포(develop 브랜치): SERVICE_DISCOVERY_HOSTNAME=bosspickseoul-service-discovery-dev
#   prod 배포(main 브랜치)   : SERVICE_DISCOVERY_HOSTNAME=bosspickseoul-service-discovery-prod
# 레지스트리가 격리되므로 서비스 앱 이름은 환경별로 분리하지 않아도 섞이지 않습니다.
# (아래는 로컬/dev 기본값)
SERVICE_DISCOVERY_HOSTNAME=bosspickseoul-service-discovery-dev

# ---------------------------------------------------------------------------
# Host exposed ports (dev: 6XXX / prod: 9XXX)
# ---------------------------------------------------------------------------
SERVICE_DISCOVERY_PORT_DEV=6761
SERVICE_DISCOVERY_PORT_PROD=9761

API_GATEWAY_PORT_DEV=6000
API_GATEWAY_PORT_PROD=9000

AUTH_SERVICE_PORT_DEV=6081
AUTH_SERVICE_PORT_PROD=9081

DISTRICT_SERVICE_PORT_DEV=6082
DISTRICT_SERVICE_PORT_PROD=9082

COMMERCIAL_SERVICE_PORT_DEV=6083
COMMERCIAL_SERVICE_PORT_PROD=9083

AI_SERVICE_PORT_DEV=6085
AI_SERVICE_PORT_PROD=9085

COMMUNITY_SERVICE_PORT_DEV=6086
COMMUNITY_SERVICE_PORT_PROD=9086

BATCH_SERVICE_PORT_DEV=6080
BATCH_SERVICE_PORT_PROD=9080

# ---------------------------------------------------------------------------
# Container memory limits (optional)
# ---------------------------------------------------------------------------
# 컨테이너 메모리 상한. 비워두면 compose 기본값(dev 512m / prod 768m)이 적용됩니다.
# JVM heap은 Dockerfile의 -XX:MaxRAMPercentage(70%)가 이 상한 기준으로 산정하므로
# 별도 -Xmx 없이 이 값만 조정하면 됩니다.
# dev 호스트(main-server, 8GB)는 MySQL/Redis와 동거하므로 상향 시 총합을 확인합니다.
#   예) AUTH_SERVICE_MEM_LIMIT_DEV=640m
#SERVICE_DISCOVERY_MEM_LIMIT_DEV=
#SERVICE_DISCOVERY_MEM_LIMIT_PROD=
#API_GATEWAY_MEM_LIMIT_DEV=
#API_GATEWAY_MEM_LIMIT_PROD=
#AUTH_SERVICE_MEM_LIMIT_DEV=
#AUTH_SERVICE_MEM_LIMIT_PROD=
#DISTRICT_SERVICE_MEM_LIMIT_DEV=
#DISTRICT_SERVICE_MEM_LIMIT_PROD=
#COMMERCIAL_SERVICE_MEM_LIMIT_DEV=
#COMMERCIAL_SERVICE_MEM_LIMIT_PROD=
#AI_SERVICE_MEM_LIMIT_DEV=
#AI_SERVICE_MEM_LIMIT_PROD=
#COMMUNITY_SERVICE_MEM_LIMIT_DEV=
#COMMUNITY_SERVICE_MEM_LIMIT_PROD=
#BATCH_SERVICE_MEM_LIMIT_DEV=
#BATCH_SERVICE_MEM_LIMIT_PROD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_USERNAME=
DB_PASSWORD=

AUTH_DB_URL=jdbc:mysql://192.168.0.11:3306/bosspickseoul_auth_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true
COMMERCIAL_DB_URL=jdbc:mysql://192.168.0.11:3306/bosspickseoul_commercial_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true
DISTRICT_DB_URL=jdbc:mysql://192.168.0.11:3306/bosspickseoul_district_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true
COMMUNITY_DB_URL=jdbc:mysql://192.168.0.11:3306/bosspickseoul_community_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true

# batch-service는 district-service가 조회하는 area_boundary 데이터를 적재합니다.
# 따라서 BATCH_DB_URL은 district 스키마를 가리키는 것을 권장합니다.
BATCH_DB_URL=jdbc:mysql://192.168.0.11:3306/bosspickseoul_district_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_MODE=standalone
REDIS_HOST=redis-node2
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Ranking pipeline (commercial-service)
# ---------------------------------------------------------------------------
# 인기 순위(분석 조회 이벤트) 파이프라인. RANKING_ENABLED=false 면 Kafka producer/consumer
# 빈이 등록되지 않아 브로커 없이도 정상 기동한다. 인기 순위 조회 API 는 Redis 만 사용.
# Kafka 가 다른 호스트(예: ollama-01)에 있으면 EXTERNAL 리스너 주소 3개를 나열한다.
#   예) KAFKA_BOOTSTRAP_SERVERS=192.168.0.10:19092,192.168.0.10:29092,192.168.0.10:39092
RANKING_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_KEY_PREFIX=bosspickseoul:dev

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=
# 로그아웃/탈퇴/비밀번호 변경 시 다른 기기의 access token은 만료까지 유효하므로
# 보안 관점에서 PT30M 수준으로 단축을 권장합니다. (회원 단위 revocation 마커 도입 전까지)
JWT_ACCESS_EXPIRATION=PT420M
JWT_REFRESH_EXPIRATION=PT10080M
JWT_BLACKLIST_FAIL_OPEN=false

# ---------------------------------------------------------------------------
# Snowflake ID
# ---------------------------------------------------------------------------
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1

# 이메일 인증코드 발송용 SMTP (auth-service).
# Gmail 사용 시 앱 비밀번호를 발급해 사용합니다. 미설정 시 기동은 되지만 발송이 실패합니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# 소셜 로그인 provider 자격증명 (auth-service).
# redirect-uri는 provider 개발자 콘솔에 등록한 값과 정확히 일치해야 합니다.
OAUTH_KAKAO_CLIENT_ID=your-kakao-rest-api-key
OAUTH_KAKAO_CLIENT_SECRET=your-kakao-client-secret
OAUTH_KAKAO_REDIRECT_URI=https://dev.bosspickseoul.com/oauth/kakao/callback
OAUTH_NAVER_CLIENT_ID=your-naver-client-id
OAUTH_NAVER_CLIENT_SECRET=your-naver-client-secret
OAUTH_NAVER_REDIRECT_URI=https://dev.bosspickseoul.com/oauth/naver/callback

# ---------------------------------------------------------------------------
# AI / LLM
# ---------------------------------------------------------------------------
AI_LLM_PROVIDER=OLLAMA
AI_LLM_BASE_URL=http://192.168.0.10:11434
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-oss:20b
# LLM 1회 생성(read) 타임아웃. 서빙 하드웨어와 모델 크기에 맞춰 실측 기준으로 설정합니다.
# gpt-oss:20b + 미니PC 기준 30초는 부족했음. 리포트는 비동기 잡이라 여유 있게 잡아도
# AI_REPORT_JOB_RUNNING_TIMEOUT_SECONDS(300s) 안이면 사용자 경험을 해치지 않습니다.
# llm 서킷의 slow-call 기준이 이 값에 연동되므로 별도 조정은 불필요합니다.
AI_LLM_TIMEOUT_MS=120000
AI_LLM_MAX_TOKENS=1200
AI_LLM_TEMPERATURE=0.2
# gpt-oss 추론 강도(low/medium/high). 기본 medium은 생성 토큰 대부분을 추론에 소모해
# 리포트 생성이 4~5배 느려집니다 (실측: low 8.2s vs medium 37.7s). low 권장.
AI_LLM_REASONING_EFFORT=low

AI_REPORT_CACHE_TTL_SECONDS=86400
AI_REPORT_JOB_TTL_SECONDS=86400
AI_REPORT_JOB_USAGE_TTL_SECONDS=2592000
AI_REPORT_JOB_PENDING_TIMEOUT_SECONDS=30
AI_REPORT_JOB_RUNNING_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Internal client timeouts
# ---------------------------------------------------------------------------
INTERNAL_CLIENT_CONNECT_TIMEOUT_MS=3000
INTERNAL_CLIENT_READ_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Batch
# ---------------------------------------------------------------------------
BATCH_AREA_BOUNDARY_IMPORT_SOURCE_DIR=
