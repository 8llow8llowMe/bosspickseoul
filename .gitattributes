# Jenkins pipeline files: always store as UTF-8 with LF
Jenkinsfile* text eol=lf working-tree-encoding=UTF-8
*.groovy    text eol=lf working-tree-encoding=UTF-8

# Markdown docs
*.md        text eol=lf working-tree-encoding=UTF-8

# Shell scripts used by CI/CD
*.sh        text eol=lf working-tree-encoding=UTF-8

# Agent role definitions and helper scripts (Codex TOML, sync script)
.codex/**/*.toml text eol=lf working-tree-encoding=UTF-8
scripts/*.py     text eol=lf working-tree-encoding=UTF-8
