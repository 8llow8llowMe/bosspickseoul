def backendPipeline
node('builder') {
    checkout scm
    backendPipeline = load 'Jenkinsfile.backend-common.groovy'
}

backendPipeline.run([
    serviceGroup       : 'service',
    serviceName        : 'batch-service',
    modulePath         : 'service:batch-service',
    fsPath             : 'backend/service/batch-service',
    dockerfile         : 'batch-service.Dockerfile',
    composeFile        : 'docker-compose-batch-service.yml',
    composeServiceName : 'batch-service',
    containerNamePrefix: 'bosspickseoul-batch-service',
    deploySubdir       : 'service/batch-service',
    buildAgentLabel    : 'builder',
    deployAgentLabels  : [
        dev : 'deploy-backend-dev',
        prod: 'deploy-backend-prod'
    ]
])
