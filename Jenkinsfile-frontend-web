// BossPickSeoul 프론트 웹(Next.js SSR) 배포 잡.
//
// Jenkins 멀티브랜치 파이프라인 이름: bosspickseoul-frontend-web
// 배포 대상 PR 라벨:                  frontend-web
//   dev  -> main-server (192.168.0.11), 호스트 포트 6300, https://dev.bosspickseoul.com
//   prod -> backend-1   (192.168.0.13), 호스트 포트 9300, https://www.bosspickseoul.com
def frontendPipeline
node('builder-frontend') {
    checkout scm
    frontendPipeline = load 'Jenkinsfile.frontend-common.groovy'
}

frontendPipeline.run([
    serviceName        : 'web',
    fsPath             : 'frontend',
    dockerfile         : 'frontend-web.Dockerfile',
    composeFile        : 'docker-compose-frontend-web.yml',
    composeServiceName : 'frontend-web',
    containerNamePrefix: 'bosspickseoul-frontend-web',
    deploySubdir       : 'web',
    bundleFile         : 'frontend-web-bundle.tar.gz',
    buildAgentLabel    : 'builder-frontend',
    deployAgentLabels  : [
        dev : 'deploy-frontend-dev',
        prod: 'deploy-frontend-prod'
    ],
    // NEXT_PUBLIC_* 는 빌드 시점에 번들로 인라인되므로 빌드 단계에서 반드시 있어야 합니다.
    // 비어 있으면 localhost 를 바라보거나 지도가 뜨지 않는 번들이 그대로 배포됩니다.
    //
    // NEXT_PUBLIC_API_URL 은 목록에 없습니다. 브라우저 REST 호출은 same-origin /api/bff 로
    // 나가고 백엔드 주소는 서버 쪽 BACKEND_API_URL 만 알면 되므로, 번들에 넣을 이유가 없습니다.
    requiredBuildEnvKeys : [
        'NEXT_PUBLIC_SITE_URL',
        'NEXT_PUBLIC_WS_URL',
        'NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY'
    ],
    // 컨테이너 기동에 필요한 런타임 값입니다. compose 가 참조하는 보간 변수 전체와 일치해야 합니다.
    // compose 에 기본값(`:-`)을 두지 않으므로, 하나라도 비면 배포 전에 여기서 막힙니다.
    // 포트와 메모리 상한은 환경 접미사가 없습니다. 환경별 .env.runtime 이 따로 만들어지므로
    // 접미사로 구분할 필요가 없고, 접미사를 붙이면 배포하지 않는 쪽 값까지 Vault 에 넣어야 합니다.
    // ('{ENV}' 를 쓰면 DEV/PROD 로 치환됩니다. 지금 쓰는 키는 없지만 규칙은 남겨둡니다)
    requiredRuntimeEnvKeys: [
        'TIME_ZONE',
        'AUTH_SESSION_SECRET',
        'BACKEND_API_URL',
        'FRONTEND_WEB_PORT',
        'FRONTEND_WEB_MEM_LIMIT'
    ]
])
