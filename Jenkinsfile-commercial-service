def backendPipeline
node('builder') {
    checkout scm
    backendPipeline = load 'Jenkinsfile.backend-common.groovy'
}

backendPipeline.run([
    serviceGroup       : 'service',
    serviceName        : 'commercial-service',
    modulePath         : 'service:commercial-service',
    fsPath             : 'backend/service/commercial-service',
    dockerfile         : 'commercial-service.Dockerfile',
    composeFile        : 'docker-compose-commercial-service.yml',
    composeServiceName : 'commercial-service',
    containerNamePrefix: 'bosspickseoul-commercial-service',
    deploySubdir       : 'service/commercial-service',
    buildAgentLabel    : 'builder',
    deployAgentLabels  : [
        dev : 'deploy-backend-dev',
        prod: 'deploy-backend-prod'
    ]
])
