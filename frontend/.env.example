# BossPickSeoul 프론트 환경변수 예시
#
# 로컬 개발은 이 파일을 `.env.local` 로 복사해 값을 채운다.
# dev/prod 배포에서는 이 목록이 그대로 Vault 의 key 목록이 된다.
#   dev  -> kv/bosspickseoul/frontend/dev/env
#   prod -> kv/bosspickseoul/frontend/prod/env
# Jenkins 가 Vault 에서 통째로 읽어 빌드/런타임에 주입하므로, 여기 없는 key 를 코드에서
# 읽기 시작했다면 이 파일과 Vault 를 함께 갱신해야 한다.
#
# ─────────────────────────────────────────────────────────────
# 주입 시점이 두 가지로 나뉜다. 헷갈리면 배포가 조용히 잘못된다.
#
#   [빌드 시점]  NEXT_PUBLIC_*
#     Next.js 가 빌드할 때 코드에 문자열로 인라인한다.
#     컨테이너 환경변수로 넣어봐야 무시되므로 dev/prod 를 각각 빌드해야 한다.
#
#   [런타임]     그 외 전부
#     서버에서만 읽히고 브라우저 번들에 들어가지 않는다. compose 의 environment 로 주입한다.
# ─────────────────────────────────────────────────────────────

# ===== 런타임 (서버 전용, 브라우저에 노출되지 않음) =====

# BFF 세션 쿠키 암호화 키. 32자 이상이어야 하며 짧으면 요청 처리 중 예외가 난다.
# 생성: openssl rand -base64 48
AUTH_SESSION_SECRET=

# 서버 컴포넌트 / Route Handler 가 호출할 백엔드 주소.
# 브라우저용 NEXT_PUBLIC_API_URL 과 달리 사설망 주소를 써도 된다.
#   dev  예) https://api-dev.bosspickseoul.com
#   prod 예) https://api.bosspickseoul.com
BACKEND_API_URL=http://localhost:8080

# 컨테이너 시간대. compose 가 TZ 로 넘긴다.
TIME_ZONE=Asia/Seoul

# ===== 배포 (compose 가 읽는 값) =====

# 호스트 바인딩 포트. dev 는 6xxx, bosspickseoul prod 는 9xxx 대역을 쓴다.
FRONTEND_WEB_PORT_DEV=6300
FRONTEND_WEB_PORT_PROD=9300

# 컨테이너 메모리 상한. compose 의 command 에 있는 --max-old-space-size 와 함께 조정한다.
FRONTEND_WEB_MEM_LIMIT_DEV=512m
FRONTEND_WEB_MEM_LIMIT_PROD=768m

# ===== 빌드 시점 (브라우저 번들에 인라인됨 — 비밀값 금지) =====

# 브라우저가 직접 호출할 API 주소.
#   dev  예) https://api-dev.bosspickseoul.com
#   prod 예) https://api.bosspickseoul.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# 사이트 절대 주소. sitemap / robots / OG 태그 생성에 쓰인다.
#   dev  예) https://dev.bosspickseoul.com
#   prod 예) https://www.bosspickseoul.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WebSocket 주소. 비우면 NEXT_PUBLIC_API_URL 에서 ws(s)://{host}/ws 로 유도한다.
NEXT_PUBLIC_WS_URL=

# 카카오 지도 / JS SDK 키
NEXT_PUBLIC_KAKAOMAP_API_KEY=
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Firebase Cloud Messaging (웹 푸시)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ===== 로컬 전용 (배포에 불필요) =====

# scripts/sync-openapi.mjs 가 백엔드 OpenAPI 문서를 받아올 주소
BOSSPICK_API_DOCS_URL=
