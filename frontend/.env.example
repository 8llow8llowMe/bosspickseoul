# BossPickSeoul 프론트 환경변수 예시
#
# 로컬 개발은 이 파일을 `.env.local` 로 복사해 값을 채운다.
# dev/prod 배포에서는 이 목록이 그대로 Vault 의 key 목록이 된다.
#   dev  -> kv/bosspickseoul/frontend/dev/env
#   prod -> kv/bosspickseoul/frontend/prod/env
# 코드에서 새 env 를 읽기 시작했다면 이 파일과 Vault 를 함께 갱신한다.
#
# ─────────────────────────────────────────────────────────────
# 주입 시점이 두 가지로 나뉜다. 헷갈리면 배포가 조용히 잘못된다.
#
#   [빌드 시점]  NEXT_PUBLIC_*
#     Next.js 가 빌드할 때 코드에 문자열로 인라인한다.
#     컨테이너 환경변수로 넣어봐야 무시되므로 dev/prod 를 각각 빌드해야 한다.
#     브라우저 번들에 그대로 박히므로 비밀값을 넣지 않는다.
#
#   [런타임]     그 외 전부
#     서버에서만 읽히고 브라우저 번들에 들어가지 않는다. compose 의 environment 로 주입한다.
# ─────────────────────────────────────────────────────────────

# ===== 런타임 (서버 전용, 브라우저에 노출되지 않음) =====

# BFF 세션 쿠키 암호화 키(A256GCM). 32자 이상이어야 하며 짧으면 요청 처리 중 예외가 난다.
# 생성: openssl rand -base64 48
#
# ⚠️ 환경당 한 번만 만들고 고정한다. 배포마다 새로 만들면 안 된다.
#    이 값이 바뀌면 기존 세션 쿠키를 복호화할 수 없어 로그인한 사용자가 전원 로그아웃된다.
#    dev 와 prod 는 서로 다른 값을 쓴다.
AUTH_SESSION_SECRET=

# 서버(BFF Route Handler / 서버 컴포넌트)가 호출할 백엔드 주소.
# 브라우저는 이 값을 모른다. REST 는 전부 same-origin /api/bff 로 나가고 BFF 가 대신 호출한다.
#   dev  예) https://api-dev.bosspickseoul.com
#   prod 예) https://api.bosspickseoul.com
# 사설 IP 로 질러도 될 것 같지만 auth API 는 게이트웨이를 거치지 않고 auth-service 로 직결되며
# 그 분기를 nginx 가 하므로 공개 도메인을 써야 한다.
BACKEND_API_URL=http://localhost:8080

# 컨테이너 시간대. compose 가 TZ 로 넘긴다.
TIME_ZONE=Asia/Seoul

# ===== 배포 (compose 가 읽는 값) =====

# 호스트 바인딩 포트. dev 는 6300, prod 는 9300 (dev 6xxx / BossPickSeoul prod 9xxx 대역).
# 환경 접미사가 없다. 환경별로 .env.runtime 이 따로 만들어지므로 각 secret 에 하나만 넣는다.
# compose 에 기본값을 두지 않으므로 비어 있으면 배포가 중단된다.
FRONTEND_WEB_PORT=6300

# 컨테이너 메모리 상한. dev 는 512m, prod 는 768m 를 권장한다.
# 이 값을 바꾸면 compose 의 --max-old-space-size(상한의 70~75%)도 함께 조정한다.
FRONTEND_WEB_MEM_LIMIT=512m

# ===== 빌드 시점 (브라우저 번들에 인라인됨 — 비밀값 금지) =====

# 사이트 절대 주소. sitemap / robots / 공유 링크 생성에 쓰인다.
#   dev  예) https://dev.bosspickseoul.com
#   prod 예) https://www.bosspickseoul.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WebSocket 주소(채팅). WebSocket 은 BFF 를 거치지 않고 브라우저가 백엔드로 직접 붙으므로
# 공개 주소가 필요하다. 배포에서는 반드시 명시한다.
#   dev  예) wss://api-dev.bosspickseoul.com/ws
#   prod 예) wss://api.bosspickseoul.com/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# 카카오 JavaScript 키. 지도 SDK 와 공유(Kakao Link) SDK 가 같은 키 하나를 쓴다.
# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# ===== 선택: FCM 웹 푸시 (채팅 알림) =====
#
# 비워두면 firebase-messaging 이 스스로 비활성화되어 앱은 정상 동작하고 푸시만 빠진다.
# (API_KEY / MESSAGING_SENDER_ID / APP_ID / VAPID_KEY 넷이 모두 있어야 켜진다)
# 푸시를 쓰기로 정하기 전에는 Vault 에 넣지 않아도 된다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# 아래는 Analytics 용이라 없어도 푸시는 동작한다.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ===== 로컬 전용 (배포에 불필요, Vault 에 넣지 않음) =====

# 브라우저 REST 호출은 /api/bff 로 나가므로 이 값은 배포에 필요 없다.
# 로컬에서 BACKEND_API_URL 을 따로 주지 않을 때의 대체값으로만 쓰인다.
NEXT_PUBLIC_API_URL=http://localhost:8080

# scripts/sync-openapi.mjs 가 백엔드 OpenAPI 문서를 받아올 주소
BOSSPICK_API_DOCS_URL=
