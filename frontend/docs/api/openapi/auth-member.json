            "type": "string",
            "description": "기기 정보 (로그인 요청의 User-Agent 요약, 표시용)",
            "example": "Mozilla/5.0 (iPhone; ...)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "최초 로그인 시각"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "description": "마지막 사용(토큰 발급/갱신) 시각"
          },
          "current": {
            "type": "boolean",
            "description": "현재 요청 기기의 세션 여부",
            "example": true
          }
        }
      },
      "AuthSessionsResponse": {
        "type": "object",
        "description": "로그인 중인 기기 세션 목록 응답 DTO",
        "properties": {
          "sessions": {
            "type": "array",
            "description": "기기 세션 목록 (마지막 사용 시각 내림차순)",
            "items": {
              "$ref": "#/components/schemas/AuthSessionItem"
            }
          }
        }
      },
      "ResponseAuthSessionsResponse": {
        "type": "object",
        "properties": {
          "dataHeader": {
            "$ref": "#/components/schemas/DataHeader"
          },
          "dataBody": {
            "$ref": "#/components/schemas/AuthSessionsResponse"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
