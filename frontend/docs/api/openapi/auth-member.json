{
  "openapi": "3.1.0",
  "info": {
    "title": "BossPickSeoul 회원 및 인증/인가 서비스 관련 API 명세서",
    "description": "Auth Service 전용",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Auth Service (단독 호출)"
    }
  ],
  "tags": [
    {
      "name": "회원",
      "description": "회원 가입, 내 정보 조회/수정, 비밀번호 변경, 탈퇴 API를 제공합니다."
    },
    {
      "name": "인증/인가",
      "description": "로그인, 로그아웃, 토큰 재발급 API를 제공합니다."
    },
    {
      "name": "북마크",
      "description": "상권/행정동/자치구 북마크 추가·삭제·목록 조회 API를 제공합니다."
    }
  ],
  "paths": {
    "/api/v1/members/signup": {
      "post": {
        "tags": ["회원"],
        "summary": "일반 회원가입",
        "description": "일반 회원으로 가입합니다.",
        "operationId": "generalSignup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberGeneralSignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/me/withdraw": {
      "post": {
        "tags": ["회원"],
        "summary": "회원 탈퇴",
        "description": "회원을 탈퇴 처리합니다. 개인정보가 마스킹되고 모든 기기의 토큰 재발급이 차단됩니다. 동일 이메일로 재가입할 수 없습니다. (다른 기기의 기존 access token은 만료 시까지 유효할 수 있으나, 회원 상태 검사로 회원 API 접근은 차단됩니다)",
        "operationId": "withdraw",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/members/me/profile-image": {
      "post": {
        "tags": ["회원"],
        "summary": "프로필 이미지 업로드",
        "description": "프로필 이미지를 업로드해 즉시 반영합니다. jpg/png/gif/webp 만 허용하며 파일 내용(매직 바이트)으로 형식을 판정합니다. 기존 이미지가 있으면 교체 후 이전 파일은 삭제됩니다.",
        "operationId": "uploadProfileImage",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageFile": {
                    "type": "string",
                    "format": "binary",
                    "description": "업로드할 이미지 파일"
                  }
                },
                "required": ["imageFile"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberProfileImageUploadResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": ["회원"],
        "summary": "프로필 이미지 삭제",
        "description": "프로필 이미지를 제거합니다. 저장된 파일도 함께 삭제됩니다.",
        "operationId": "removeProfileImage",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberMyInfoResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/members/me/password": {
      "post": {
        "tags": ["회원"],
        "summary": "비밀번호 변경",
        "description": "현재 비밀번호 확인 후 새 비밀번호로 변경합니다. 변경 후 재로그인이 필요하며, 모든 기기의 토큰 재발급이 차단됩니다. (다른 기기의 기존 access token은 만료 시까지 유효할 수 있습니다)",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberPasswordChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/members/me/bookmarks": {
      "get": {
        "tags": ["북마크"],
        "summary": "북마크 목록 조회",
        "description": "내 북마크 목록을 최신순으로 커서 페이지네이션으로 조회합니다.",
        "operationId": "getBookmarks",
        "parameters": [
          {
            "name": "lastBookmarkId",
            "in": "query",
            "description": "마지막으로 조회한 북마크 아이디 (첫 페이지: 생략)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "조회 개수 (기본 10, 최대 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10,
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberBookmarksResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": ["북마크"],
        "summary": "북마크 추가",
        "description": "상권·행정동·자치구를 북마크에 추가합니다.",
        "operationId": "addBookmark",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberBookmarkCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberBookmarkCreateResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/token/reissue": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "토큰 재발급",
        "description": "리프레시 토큰으로 Access Token을 재발급합니다.",
        "operationId": "reissueToken",
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseTokenReissueResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "로그아웃",
        "description": "로그아웃하고 리프레시 토큰을 무효화합니다.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "일반 로그인",
        "description": "이메일과 비밀번호로 로그인합니다. 실패가 누적되면 해당 이메일이 일정 시간 잠깁니다(AUTH_015, 429).",
        "operationId": "loginWithCredentials",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthGeneralLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAuthGeneralLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email/verify-code": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "이메일 인증코드 검증",
        "description": "메일로 받은 인증코드를 검증합니다. 성공하면 30분 동안 해당 이메일로 회원가입할 수 있습니다.",
        "operationId": "verifyEmailVerificationCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthEmailCodeVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email/send-code": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "이메일 인증코드 발송",
        "description": "회원가입용 이메일 인증코드를 발송합니다. 60초 쿨다운이 적용되며, 가입 여부와 무관하게 항상 성공으로 응답합니다(기가입 이메일에는 안내 메일 발송).",
        "operationId": "sendEmailVerificationCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthEmailCodeSendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/me": {
      "get": {
        "tags": ["회원"],
        "summary": "내 회원 정보 조회",
        "description": "로그인한 회원의 내 정보를 조회합니다.",
        "operationId": "getMyInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberMyInfoResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "tags": ["회원"],
        "summary": "내 회원 정보 수정",
        "description": "닉네임을 수정합니다. 프로필 이미지는 이 API가 아니라 전용 업로드/삭제 API로 관리합니다.",
        "operationId": "updateMyInfo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberMyInfoUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberMyInfoResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/{provider}/login": {
      "get": {
        "tags": ["인증/인가"],
        "summary": "소셜 로그인",
        "description": "provider 콜백의 인가코드와 state로 로그인합니다. 미가입 이메일이면 자동 회원가입 후 로그인합니다. 응답은 일반 로그인과 동일합니다(accessToken + refresh 쿠키).",
        "operationId": "loginWithOAuthCode",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "소셜 로그인 제공자",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["KAKAO", "NAVER"]
            },
            "example": "kakao"
          },
          {
            "name": "code",
            "in": "query",
            "description": "provider가 콜백으로 전달한 인가코드",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "인가 URL 생성 시 발급된 state",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAuthGeneralLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/{provider}/authorize": {
      "get": {
        "tags": ["인증/인가"],
        "summary": "소셜 로그인 인가 URL 생성",
        "description": "provider(kakao/naver) 인가 페이지 URL을 생성합니다. CSRF 방어용 state가 포함되며 10분간 유효합니다. 프론트는 이 URL로 리다이렉트합니다.",
        "operationId": "generateOAuthAuthorizationUrl",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "소셜 로그인 제공자",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["KAKAO", "NAVER"]
            },
            "example": "kakao"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAuthOAuthAuthorizeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/me/bookmarks/{bookmarkId}": {
      "delete": {
        "tags": ["북마크"],
        "summary": "북마크 삭제",
        "description": "북마크 아이디로 본인 북마크를 삭제합니다.",
        "operationId": "removeBookmark",
        "parameters": [
          {
            "name": "bookmarkId",
            "in": "path",
            "description": "북마크 아이디",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MemberGeneralSignupRequest": {
        "type": "object",
        "description": "일반 회원가입 요청 DTO",
        "properties": {
          "email": {
            "type": "string",
            "description": "이메일 주소",
            "example": "user@example.com",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "비밀번호 (영문자, 숫자, 특수문자 포함 8~20자)",
            "example": "password123!",
            "maxLength": 20,
            "minLength": 8,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d)(?=.*[!@#$%^&*()\\-_=+\\[\\]{};:'\",.<>/?\\\\|])\\S+$"
          },
          "name": {
            "type": "string",
            "description": "회원 이름",
            "example": "홍길동",
            "maxLength": 10,
            "minLength": 0
          },
          "nickname": {
            "type": "string",
            "description": "회원 닉네임",
            "example": "길동짱",
            "maxLength": 10,
            "minLength": 0
          }
        }
      },
      "DataHeader": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "resultCode": {
            "type": "string"
          },
          "resultMessage": {
            "type": "object"
          }
        }
      },
      "ResponseVoid": {
        "type": "object",
        "properties": {
          "dataHeader": {
            "$ref": "#/components/schemas/DataHeader"
          },
          "dataBody": {
            "type": "object"
          }
        }
      },
      "MemberProfileImageUploadResponse": {
        "type": "object",
        "description": "프로필 이미지 업로드 응답 DTO",
        "properties": {
          "profileImageKey": {
            "type": "string",
            "description": "저장된 오브젝트 키 (서버 내부 식별자)",
            "example": "members/profiles/202507110001/2026/08/3f2a9c11-0e4b-4a1f-9c3d-0b8e2f7a5d61.png"
          },
          "profileImageUrl": {
            "type": "string",
            "description": "프로필 이미지 공개 URL",
            "example": "https://minio.8llow8llowme.com/bosspickseoul/members/profiles/202507110001/2026/08/3f2a9c11-0e4b-4a1f-9c3d-0b8e2f7a5d61.png"
          }
        }
      },
      "ResponseMemberProfileImageUploadResponse": {
        "type": "object",
        "properties": {
          "dataHeader": {
            "$ref": "#/components/schemas/DataHeader"
          },
          "dataBody": {
            "$ref": "#/components/schemas/MemberProfileImageUploadResponse"
          }
        }
      },
      "MemberPasswordChangeRequest": {
        "type": "object",
        "description": "비밀번호 변경 요청 DTO",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "현재 비밀번호",
            "example": "password123!",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "description": "새 비밀번호 (영문자, 숫자, 특수문자 포함 8~20자)",
            "example": "newPassword456!",
            "maxLength": 20,
            "minLength": 8,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d)(?=.*[!@#$%^&*()\\-_=+\\[\\]{};:'\",.<>/?\\\\|])\\S+$"
          }
        }
      },
      "MemberBookmarkCreateRequest": {
        "type": "object",
        "description": "북마크 추가 요청 DTO",
        "properties": {
          "targetType": {
            "type": "string",
            "description": "북마크 대상 타입",
            "enum": ["COMMERCIAL", "ADMINISTRATION", "DISTRICT"],
            "example": "COMMERCIAL"
          },
          "targetCode": {
            "type": "string",
            "description": "북마크 대상 코드",
            "example": 3110008,
            "maxLength": 20,
            "minLength": 0
          },
          "targetName": {
            "type": "string",
            "description": "북마크 대상 이름 (스냅샷)",
            "example": "강남역 상권",
            "maxLength": 80,
            "minLength": 0
          }
        },
        "required": ["targetType"]
      },
      "MemberBookmarkCreateResponse": {
        "type": "object",
        "description": "북마크 추가 응답 DTO",
        "properties": {
          "bookmarkId": {
            "type": "string",
            "description": "북마크 아이디",
            "example": 7345678901234568000
          },
          "targetType": {
