{
  "openapi": "3.1.0",
  "info": {
    "title": "BossPickSeoul 회원 및 인증/인가 서비스 관련 API 명세서",
    "description": "Auth Service 전용",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Auth Service (단독 호출)"
    }
  ],
  "tags": [
    {
      "name": "개발용 (prod 미노출)",
      "description": "개발/테스트 편의 API. 운영 프로필에서는 존재하지 않습니다."
    },
    {
      "name": "회원",
      "description": "회원 가입, 내 정보 조회/수정, 비밀번호 변경, 탈퇴 API를 제공합니다."
    },
    {
      "name": "인증/인가",
      "description": "로그인, 로그아웃, 토큰 재발급 API를 제공합니다."
    },
    {
      "name": "북마크",
      "description": "상권/행정동/자치구 북마크 추가·삭제·목록 조회 API를 제공합니다."
    }
  ],
  "paths": {
    "/api/v1/members/signup": {
      "post": {
        "tags": ["회원"],
        "summary": "일반 회원가입",
        "description": "일반 회원으로 가입합니다.",
        "operationId": "generalSignup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberGeneralSignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/signup/dev": {
      "post": {
        "tags": ["개발용 (prod 미노출)"],
        "summary": "[개발용] 즉시 회원가입 (이메일 인증 생략)",
        "description": "이메일 인증코드 검증 없이 계정을 바로 만듭니다. 테스트 계정 생성 전용이며,\n비밀번호 규칙·이메일 중복 검증(409 MEMBER_001)은 일반 가입과 동일하게 적용됩니다.\n응답의 email/비밀번호로 바로 POST /api/v1/auth/login 을 호출해 테스트할 수 있습니다.\nprod 프로필에서는 이 API 가 등록되지 않습니다.",
        "operationId": "devSignup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberGeneralSignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberDevSignupResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/me/withdraw": {
      "post": {
        "tags": ["회원"],
        "summary": "회원 탈퇴",
        "description": "회원을 탈퇴 처리합니다. 개인정보가 마스킹되고 모든 기기의 토큰 재발급이 차단됩니다. 동일 이메일로 재가입할 수 없습니다. (다른 기기의 기존 access token은 만료 시까지 유효할 수 있으나, 회원 상태 검사로 회원 API 접근은 차단됩니다)",
        "operationId": "withdraw",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/members/me/profile-image": {
      "post": {
        "tags": ["회원"],
        "summary": "프로필 이미지 업로드",
        "description": "프로필 이미지를 업로드해 즉시 반영합니다. jpg/png/gif/webp 만 허용하며 파일 내용(매직 바이트)으로 형식을 판정합니다. 기존 이미지가 있으면 교체 후 이전 파일은 삭제됩니다.",
        "operationId": "uploadProfileImage",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageFile": {
                    "type": "string",
                    "format": "binary",
                    "description": "업로드할 이미지 파일"
                  }
                },
                "required": ["imageFile"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberProfileImageUploadResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": ["회원"],
        "summary": "프로필 이미지 삭제",
        "description": "프로필 이미지를 제거합니다. 저장된 파일도 함께 삭제됩니다.",
        "operationId": "removeProfileImage",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberMyInfoResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/members/me/password": {
      "post": {
        "tags": ["회원"],
        "summary": "비밀번호 변경",
        "description": "현재 비밀번호 확인 후 새 비밀번호로 변경합니다. 변경 후 재로그인이 필요하며, 모든 기기의 토큰 재발급이 차단됩니다. (다른 기기의 기존 access token은 만료 시까지 유효할 수 있습니다)",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberPasswordChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": ["회원"],
        "summary": "소셜 전용 계정 전환 (비밀번호 제거)",
        "description": "소셜 로그인이 연결된 계정의 비밀번호를 제거해 소셜 전용 계정으로 전환합니다. 전환 후 이메일 로그인은 불가하며, 모든 기기에서 로그아웃됩니다. 소셜이 연결되지 않은 일반 계정은 400(MEMBER_009), 이미 소셜 전용이면 400(MEMBER_007)으로 응답합니다.",
        "operationId": "removePassword",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/members/me/password/setup": {
      "post": {
        "tags": ["회원"],
        "summary": "비밀번호 최초 설정",
        "description": "소셜 로그인으로 가입해 비밀번호가 없는 계정에 비밀번호를 설정합니다. 설정 후에는 이메일 로그인과 소셜 로그인 모두 사용할 수 있습니다. 이미 비밀번호가 있는 계정은 400(MEMBER_008)으로 응답합니다.",
        "operationId": "setupPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberPasswordSetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/members/me/bookmarks": {
      "get": {
        "tags": ["북마크"],
        "summary": "북마크 목록 조회",
        "description": "내 북마크 목록을 최신순으로 커서 페이지네이션으로 조회합니다.",
        "operationId": "getBookmarks",
        "parameters": [
          {
            "name": "lastBookmarkId",
            "in": "query",
            "description": "마지막으로 조회한 북마크 아이디 (첫 페이지: 생략)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "조회 개수 (기본 10, 최대 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10,
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberBookmarksResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": ["북마크"],
        "summary": "북마크 추가",
        "description": "상권·행정동·자치구를 북마크에 추가합니다.",
        "operationId": "addBookmark",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberBookmarkCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberBookmarkCreateResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/token/reissue": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "토큰 재발급",
        "description": "리프레시 토큰으로 Access Token을 재발급합니다.",
        "operationId": "reissueToken",
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseTokenReissueResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/reset": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "비밀번호 재설정",
        "description": "메일로 받은 인증코드로 비밀번호를 재설정합니다. 성공 시 전 기기 세션이 무효화되어 재로그인이 필요합니다.\n코드 불일치는 AUTH_004, 만료/미발급은 AUTH_005, 5회 실패 시 코드가 무효화되고 AUTH_017 로 응답합니다.",
        "operationId": "resetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthPasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/reset/send-code": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "비밀번호 재설정 코드 발송",
        "description": "비밀번호 재설정 인증코드를 메일로 발송합니다. 일반(이메일+비밀번호) 계정 전용입니다.\n계정 존재 여부와 무관하게 항상 성공으로 응답하며, 미가입 이메일과 소셜 전용 계정에는\n각각 안내 메일이 발송됩니다. 이메일당 60초 쿨다운(AUTH_003)과 IP당 발송 상한(AUTH_016)이 적용됩니다.",
        "operationId": "sendPasswordResetCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthPasswordResetCodeSendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "로그아웃",
        "description": "현재 기기의 세션만 로그아웃합니다 (리프레시 토큰 무효화 + Access 토큰 블랙리스트). 다른 기기의 로그인은 유지됩니다.",
        "operationId": "logout",
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "일반 로그인",
        "description": "이메일과 비밀번호로 로그인합니다. 실패가 누적되면 해당 이메일이 일정 시간 잠깁니다(AUTH_015, 429).",
        "operationId": "loginWithCredentials",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthGeneralLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAuthGeneralLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email/verify-code": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "이메일 인증코드 검증",
        "description": "메일로 받은 인증코드를 검증합니다. 성공하면 30분 동안 해당 이메일로 회원가입할 수 있습니다.",
        "operationId": "verifyEmailVerificationCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthEmailCodeVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email/send-code": {
      "post": {
        "tags": ["인증/인가"],
        "summary": "이메일 인증코드 발송",
        "description": "회원가입용 이메일 인증코드를 발송합니다. 이메일당 60초 쿨다운(AUTH_003)과 IP당 시간당 발송 상한(AUTH_016)이 적용되며, 가입 여부와 무관하게 항상 성공으로 응답합니다(기가입 이메일에는 안내 메일 발송).",
        "operationId": "sendEmailVerificationCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthEmailCodeSendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/me": {
      "get": {
        "tags": ["회원"],
        "summary": "내 회원 정보 조회",
        "description": "로그인한 회원의 내 정보를 조회합니다.",
        "operationId": "getMyInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberMyInfoResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "tags": ["회원"],
        "summary": "내 회원 정보 수정",
        "description": "닉네임을 수정합니다. 프로필 이미지는 이 API가 아니라 전용 업로드/삭제 API로 관리합니다.",
        "operationId": "updateMyInfo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberMyInfoUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMemberMyInfoResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/{provider}/login": {
      "get": {
        "tags": ["인증/인가"],
        "summary": "소셜 로그인",
        "description": "provider 콜백의 인가코드와 state로 로그인합니다. 미가입 이메일이면 자동 회원가입 후 로그인합니다. 응답은 일반 로그인과 동일합니다(accessToken + refresh 쿠키).",
        "operationId": "loginWithOAuthCode",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "소셜 로그인 제공자",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["KAKAO", "NAVER"]
            },
            "example": "kakao"
          },
          {
            "name": "code",
            "in": "query",
            "description": "provider가 콜백으로 전달한 인가코드",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "인가 URL 생성 시 발급된 state",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAuthGeneralLoginResponse"
                }
              }
            }
          }
