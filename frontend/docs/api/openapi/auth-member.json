    "/api/v1/auth/{provider}/authorize": {
      "get": {
        "tags": ["인증/인가"],
        "summary": "소셜 로그인 인가 URL 생성",
        "description": "provider(kakao/naver) 인가 페이지 URL을 생성합니다. CSRF 방어용 state가 포함되며 10분간 유효합니다. 프론트는 이 URL로 리다이렉트합니다.",
        "operationId": "generateOAuthAuthorizationUrl",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "소셜 로그인 제공자",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["KAKAO", "NAVER"]
            },
            "example": "kakao"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAuthOAuthAuthorizeResponse"
                }
              }
            }
          }
        }
      }
    },
