  "components": {
    "schemas": {
      "CommunityReportCreateRequest": {
        "type": "object",
        "description": "신고 등록 요청",
        "properties": {
          "targetKind": {
            "type": "string",
            "description": "신고 대상 타입",
            "enum": ["POST", "COMMENT"],
            "example": "POST"
          },
          "targetId": {
            "type": "integer",
            "format": "int64",
            "description": "신고 대상 ID",
            "example": 1001
          },
          "reason": {
            "type": "string",
            "description": "신고 사유",
            "example": "광고성 게시글입니다.",
            "maxLength": 500,
            "minLength": 0
          }
        },
        "required": ["targetKind"]
      },
      "DataHeader": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "resultCode": {
            "type": "string"
          },
          "resultMessage": {
            "type": "object"
          }
        }
      },
      "ResponseVoid": {
        "type": "object",
        "properties": {
          "dataHeader": {
            "$ref": "#/components/schemas/DataHeader"
          },
          "dataBody": {
            "type": "object"
          }
        }
      },
      "CommunityPostCreateRequest": {
        "type": "object",
        "description": "게시글 작성 요청",
        "properties": {
          "targetType": {
            "type": "string",
            "description": "대상 타입",
            "example": "COMMERCIAL",
            "minLength": 1
          },
          "targetCode": {
            "type": "string",
            "description": "대상 코드",
            "example": 3110008,
            "minLength": 1
          },
          "title": {
            "type": "string",
            "description": "게시글 제목",
            "example": "강남역 상권 분석",
            "maxLength": 120,
            "minLength": 0
          },
