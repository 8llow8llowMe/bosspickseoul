            "schema": {
              "type": "string",
              "default": "LATEST",
              "enum": ["LATEST", "POPULAR"]
            }
          },
          {
            "name": "orderType",
            "in": "query",
            "description": "정렬 방향",
            "required": false,
            "schema": {
              "type": "string",
              "default": "DESC",
              "enum": ["ASC", "DESC"]
            }
          },
          {
            "name": "targetType",
            "in": "query",
            "description": "대상 타입 필터",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "targetCode",
            "in": "query",
            "description": "대상 코드 필터",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastPostId",
            "in": "query",
            "description": "마지막 게시글 ID",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "example": 0
          },
          {
            "name": "lastLikeCount",
            "in": "query",
            "description": "인기순 조회 시 마지막 좋아요 수 커서",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "example": 0
          },
          {
            "name": "size",
            "in": "query",
            "description": "조회 개수",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            },
            "example": 20
