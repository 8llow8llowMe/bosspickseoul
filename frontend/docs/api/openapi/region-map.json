{
  "openapi": "3.1.0",
  "info": {
    "title": "BossPickSeoul 지역 및 지도 서비스 관련 API 명세서",
    "description": "District Service 전용",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "API Gateway (실제 호출용)"
    }
  ],
  "tags": [
    {
      "name": "지역 조회",
      "description": "자치구, 행정동, 상권의 계층형 지역 정보를 조회하는 API를 제공합니다."
    },
    {
      "name": "지도 영역",
      "description": "지도에 표시할 영역 좌표와 상권 히트맵을 제공하는 API입니다."
    }
  ],
  "paths": {
    "/api/v1/regions/districts/{districtCode}": {
      "get": {
        "tags": ["지역 조회"],
        "summary": "자치구 단건 조회",
        "description": "자치구 코드로 자치구 명칭을 조회합니다.",
        "operationId": "getDistrictByDistrictCode",
        "parameters": [
          {
            "name": "districtCode",
            "in": "path",
            "description": "자치구 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 11680
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseDistrictAreaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/districts/{districtCode}/administrations": {
      "get": {
        "tags": ["지역 조회"],
        "summary": "자치구 소속 행정동 목록 조회",
        "description": "선택한 자치구에 포함된 행정동 목록과 중심 좌표를 조회합니다.",
        "operationId": "getAdministrationsByDistrictCode",
        "parameters": [
          {
            "name": "districtCode",
            "in": "path",
            "description": "자치구 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 11680
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseListAdministrationAreaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/districts/{districtCode}/administrations/{administrationCode}/commercials": {
      "get": {
        "tags": ["지역 조회"],
        "summary": "행정동 소속 상권 목록 조회",
        "description": "선택한 행정동에 포함된 상권 목록과 중심 좌표를 조회합니다.",
        "operationId": "getCommercialsByAdministrationCode",
        "parameters": [
          {
            "name": "districtCode",
            "in": "path",
            "description": "자치구 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 11680
          },
          {
            "name": "administrationCode",
            "in": "path",
            "description": "행정동 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 11680101
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseListCommercialAreaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/commercials/{commercialCode}/administration": {
      "get": {
        "tags": ["지역 조회"],
        "summary": "상권 소속 지역 조회",
        "description": "상권 코드로 소속 행정동과 자치구 정보를 조회합니다.",
        "operationId": "getCommercialAdministrationByCommercialCode",
        "parameters": [
          {
            "name": "commercialCode",
            "in": "path",
            "description": "상권 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 3110008
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseCommercialAdministrationAreaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/code-lookup": {
      "get": {
        "tags": ["지역 조회"],
        "summary": "지역 명칭 기준 코드 조회",
        "description": "자치구명, 행정동명, 상권명을 기준으로 지역 코드를 조회합니다.",
        "operationId": "lookupRegionCode",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "지역 코드 유형",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["DISTRICT", "ADMINISTRATION", "COMMERCIAL"]
            },
            "example": "DISTRICT"
          },
          {
            "name": "name",
            "in": "query",
            "description": "지역 명칭",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "종로구"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegionCodeLookupResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/administrations/{administrationCode}": {
      "get": {
        "tags": ["지역 조회"],
        "summary": "행정동 상위 지역 조회",
        "description": "행정동 코드로 소속 자치구와 행정동 정보를 조회합니다.",
        "operationId": "getAdministrationDistrictByAdministrationCode",
        "parameters": [
          {
            "name": "administrationCode",
            "in": "path",
            "description": "행정동 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 11680101
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAdministrationDistrictAreaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/districts": {
      "get": {
        "tags": ["지도 영역"],
        "summary": "자치구 영역 좌표 조회",
        "description": "지도 뷰포트 범위 안에 포함된 자치구 영역 좌표 목록을 조회합니다.",
        "operationId": "getDistrictAreaCoords",
        "parameters": [
          {
            "name": "lngSW",
            "in": "query",
            "description": "남서쪽 경도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 126.9
          },
          {
            "name": "latSW",
            "in": "query",
            "description": "남서쪽 위도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 37.45
          },
          {
            "name": "lngNE",
            "in": "query",
            "description": "북동쪽 경도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 127.1
          },
          {
            "name": "latNE",
            "in": "query",
            "description": "북동쪽 위도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 37.7
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMapAreaCoordsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/commercials": {
      "get": {
        "tags": ["지도 영역"],
        "summary": "상권 영역 좌표 조회",
        "description": "지도 뷰포트 범위 안에 포함된 상권 영역 좌표 목록을 조회합니다.",
        "operationId": "getCommercialAreaCoords",
        "parameters": [
          {
            "name": "lngSW",
            "in": "query",
            "description": "남서쪽 경도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 126.9
          },
          {
            "name": "latSW",
            "in": "query",
            "description": "남서쪽 위도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 37.45
          },
          {
            "name": "lngNE",
            "in": "query",
            "description": "북동쪽 경도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 127.1
          },
          {
            "name": "latNE",
            "in": "query",
            "description": "북동쪽 위도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 37.7
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseMapAreaCoordsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/commercials/{commercialCode}/profile": {
      "get": {
        "tags": ["지도 영역"],
        "summary": "상권 프로필 조회",
        "description": "지도에서 선택한 상권의 프로필 카드 정보를 조회합니다.",
        "operationId": "getCommercialProfile",
        "parameters": [
          {
            "name": "commercialCode",
            "in": "path",
            "description": "상권 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 3110008
          },
          {
            "name": "serviceCode",
            "in": "query",
            "description": "서비스 업종 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "CS100001"
          },
          {
            "name": "periodCode",
            "in": "query",
            "description": "기준 분기 코드",
            "required": false,
            "schema": {
              "type": "string",
              "default": "20233"
            },
            "example": 20233
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseCommercialProfileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/commercials/heatmap": {
      "get": {
        "tags": ["지도 영역"],
        "summary": "상권 히트맵 조회",
        "description": "지도에 표시할 상권 히트맵을 조회합니다. composite=false 이면 metricType 으로 단일 지표, composite=true 이면 preset 기반 복합 점수를 반환합니다. 해당 모드에 필요한 파라미터가 누락되면 400 을 반환합니다.",
        "operationId": "getCommercialHeatmap",
        "parameters": [
          {
            "name": "lngSW",
            "in": "query",
            "description": "남서쪽 경도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 126.9
          },
          {
            "name": "latSW",
            "in": "query",
            "description": "남서쪽 위도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 37.45
          },
          {
            "name": "lngNE",
            "in": "query",
            "description": "북동쪽 경도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 127.1
          },
          {
            "name": "latNE",
            "in": "query",
            "description": "북동쪽 위도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 37.7
          },
          {
            "name": "serviceCode",
            "in": "query",
            "description": "서비스 업종 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "CS100001"
          },
          {
            "name": "periodCode",
            "in": "query",
            "description": "기준 분기 코드",
            "required": false,
            "schema": {
              "type": "string",
              "default": "20233"
            },
            "example": 20233
          },
          {
            "name": "metricType",
            "in": "query",
            "description": "지표 타입 (composite=false 일 때 필수)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPPORTUNITY_SCORE",
                "RISK_SCORE",
                "CONGESTION_SCORE",
                "RESIDENT_POPULATION_SCORE"
              ]
            },
            "example": "OPPORTUNITY_SCORE"
          },
          {
            "name": "preset",
            "in": "query",
            "description": "후보 프리셋 (composite=true 일 때 필수)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "BALANCED",
                "AGGRESSIVE_OPPORTUNITY",
                "STABLE_LOW_RISK",
                "LOW_BUDGET_RESIDENT",
                "YOUTH_STARTUP",
                "RE_EMPLOYMENT_STARTUP"
              ]
            },
            "example": "BALANCED"
          },
          {
            "name": "priorityMetric",
            "in": "query",
            "description": "우선 지표 (composite=true 일 때 선택, 미지정 시 프리셋 기본값)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPPORTUNITY_SCORE",
                "RISK_SCORE",
                "CONGESTION_SCORE",
                "RESIDENT_POPULATION_SCORE"
              ]
            }
          },
          {
            "name": "composite",
            "in": "query",
            "description": "복합 점수 모드 여부",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "example": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseCommercialHeatmapResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/commercials/compare-preview": {
      "get": {
        "tags": ["지도 영역"],
        "summary": "상권 비교 프리뷰 조회",
        "description": "두 상권의 경량 비교 정보(종합 요약 + 핵심 지표 + 추천 측)를 반환합니다.",
        "operationId": "getCommercialComparePreview",
        "parameters": [
          {
            "name": "leftCommercialCode",
            "in": "query",
            "description": "좌측 상권 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 3110008
          },
          {
            "name": "rightCommercialCode",
            "in": "query",
            "description": "우측 상권 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 3110012
          },
          {
            "name": "serviceCode",
            "in": "query",
            "description": "서비스 업종 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "CS100001"
          },
          {
            "name": "periodCode",
            "in": "query",
            "description": "기준 분기 코드",
            "required": false,
            "schema": {
              "type": "string",
              "default": "20233"
            },
            "example": 20233
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseCommercialComparePreviewResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/commercials/candidates": {
      "get": {
        "tags": ["지도 영역"],
        "summary": "후보 상권 랭킹 조회",
        "description": "프리셋 가중치와 우선 지표 기준으로 지도 범위 내 후보 상권 Top N 을 조회합니다.",
        "operationId": "getCandidateCommercials",
        "parameters": [
          {
            "name": "lngSW",
            "in": "query",
            "description": "남서쪽 경도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 126.9
          },
          {
            "name": "latSW",
            "in": "query",
            "description": "남서쪽 위도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 37.45
          },
          {
            "name": "lngNE",
            "in": "query",
            "description": "북동쪽 경도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 127.1
          },
          {
            "name": "latNE",
            "in": "query",
            "description": "북동쪽 위도",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "example": 37.7
          },
          {
            "name": "serviceCode",
            "in": "query",
            "description": "서비스 업종 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "CS100001"
          },
          {
            "name": "preset",
            "in": "query",
            "description": "후보 탐색 프리셋",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "BALANCED",
                "AGGRESSIVE_OPPORTUNITY",
                "STABLE_LOW_RISK",
                "LOW_BUDGET_RESIDENT",
                "YOUTH_STARTUP",
                "RE_EMPLOYMENT_STARTUP"
              ]
            },
            "example": "BALANCED"
          },
          {
            "name": "priorityMetric",
            "in": "query",
            "description": "우선 지표 (미지정 시 프리셋 기본값)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPPORTUNITY_SCORE",
                "RISK_SCORE",
                "CONGESTION_SCORE",
                "RESIDENT_POPULATION_SCORE"
              ]
            }
          },
          {
            "name": "topN",
            "in": "query",
            "description": "상위 N (기본 10, 5~30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 30,
              "minimum": 5
            },
            "example": 10
          },
          {
            "name": "periodCode",
            "in": "query",
            "description": "기준 분기 코드",
            "required": false,
            "schema": {
              "type": "string",
              "default": "20233"
            },
            "example": 20233
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseCandidateCommercialsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/candidate-presets": {
      "get": {
        "tags": ["지도 영역"],
        "summary": "후보 탐색 프리셋 조회",
        "description": "후보 상권 탐색에 사용할 프리셋 목록을 조회합니다.",
        "operationId": "getCandidatePresets",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseCandidatePresetsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/administrations": {
      "get": {
        "tags": ["지도 영역"],
        "summary": "행정동 영역 좌표 조회",
        "description": "지도 뷰포트 범위 안에 포함된 행정동 영역 좌표 목록을 조회합니다.",
        "operationId": "getAdministrationAreaCoords",
        "parameters": [
          {
            "name": "lngSW",
            "in": "query",
            "description": "남서쪽 경도",
            "required": true,
