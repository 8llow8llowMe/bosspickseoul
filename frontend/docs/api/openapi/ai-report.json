            "schema": {
              "type": "string"
            },
            "example": "CS100001"
          },
          {
            "name": "periodCode",
            "in": "query",
            "description": "기준 분기 코드",
            "required": false,
            "schema": {
              "type": "string",
              "default": "20233"
            },
            "example": 20233
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAiReportSubmissionResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/ai-reports/commercials/comparisons": {
      "post": {
        "tags": ["AI 리포트"],
        "summary": "상권 비교 AI 인사이트 제출 (비동기)",
        "description": "상권 비교 AI 인사이트 작업을 제출합니다. 캐시 hit 면 200 + 결과, miss 면 202 + jobId 를 반환합니다. 캐시 miss 인데 일별 사용량 상한을 넘겼으면 429 (AI_012) 로 거절됩니다.",
        "operationId": "submitCommercialComparisonReport",
        "parameters": [
          {
            "name": "leftCommercialCode",
            "in": "query",
            "description": "좌측 상권 코드",
            "required": true,
            "schema": {
              "type": "string",
              "description": "좌측 상권 코드",
              "example": "3110008",
              "minLength": 1
            },
            "example": 3110008
          },
          {
            "name": "rightCommercialCode",
            "in": "query",
            "description": "우측 상권 코드",
            "required": true,
            "schema": {
              "type": "string",
              "description": "우측 상권 코드",
              "example": "3110012",
              "minLength": 1
            },
            "example": 3110012
          },
          {
            "name": "serviceCode",
            "in": "query",
            "description": "서비스 코드",
            "required": true,
            "schema": {
              "type": "string",
              "description": "서비스 코드",
              "example": "CS100001",
              "minLength": 1
            },
            "example": "CS100001"
          },
          {
            "name": "periodCode",
            "in": "query",
            "description": "기준 분기 코드",
            "required": false,
            "schema": {
              "type": "string",
              "default": "20233",
              "description": "기준 분기 코드",
              "example": "20233"
            },
            "example": 20233
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAiReportSubmissionResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/ai-reports/administrations/{administrationCode}": {
