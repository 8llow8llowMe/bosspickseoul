{
  "openapi": "3.1.0",
  "info": {
    "title": "BossPickSeoul AI 리포트 서비스 관련 API 명세서",
    "description": "AI Service 전용",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "API Gateway (실제 호출용)"
    }
  ],
  "tags": [
    {
      "name": "AI 리포트",
      "description": "상권, 자치구, 행정동 분석 데이터를 AI 관점으로 요약하는 API를 제공합니다."
    }
  ],
  "paths": {
    "/api/v1/ai-reports/districts/{districtCode}": {
      "post": {
        "tags": ["AI 리포트"],
        "summary": "자치구 AI 리포트 제출 (비동기)",
        "description": "자치구 AI 리포트 작업을 제출합니다. 캐시 hit 면 200 + 결과, miss 면 202 + jobId 를 반환합니다. 캐시 miss 인데 일별 사용량 상한을 넘겼으면 429 (AI_012) 로 거절됩니다.",
        "operationId": "submitDistrictReport",
        "parameters": [
          {
            "name": "districtCode",
            "in": "path",
            "description": "자치구 코드",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 11680
          },
          {
            "name": "periodCode",
            "in": "query",
            "description": "기준 분기 코드",
            "required": false,
            "schema": {
              "type": "string",
              "default": "20233"
            },
            "example": 20233
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseAiReportSubmissionResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/ai-reports/commercials/{commercialCode}": {
